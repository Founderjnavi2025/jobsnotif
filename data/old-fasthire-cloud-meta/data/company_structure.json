            "job_details": {
              "job_title": "Department Manager",
              "department": "Executive Management",
              "job_level": "Manager",
              "job_description": "Memimpin satu departemen secara menyeluruh, mengelola tim, anggaran, dan proses kerja untuk mencapai tujuan departemen yang selaras dengan strategi perusahaan. Bertanggung jawab atas pengembangan tim dan efisiensi operasional departemen.",
              "responsibilities": [
                "Menyusun rencana kerja dan target departemen sesuai arahan direksi.",
                "Mengelola, membina, dan mengevaluasi kinerja anggota tim departemen.",
                "Mengawasi anggaran departemen dan memastikan efisiensi pengeluaran.",
                "Mengembangkan SOP dan proses kerja departemen.",
                "Berkoordinasi dengan manajer departemen lain untuk proyek lintas fungsi.",
                "Menyusun laporan kinerja departemen secara berkala.",
                "Mengidentifikasi kebutuhan pelatihan dan pengembangan tim."
              ],
              "qualifications": [
                "Gelar S1 di bidang terkait departemen (Manajemen, Akuntansi, Teknik, dll.).",
                "Pengalaman minimal 7 tahun dengan minimal 2 tahun di posisi supervisory.",
                "Kemampuan memimpin dan mengembangkan tim.",
                "Pemahaman tentang proses bisnis departemen terkait.",
                "Kemampuan analisis dan pelaporan kinerja."
              ],
              "technical_skills": [
                "Departmental Planning",
                "Budget Management",
                "Performance Management",
                "SOP Development",
                "Reporting & Analytics",
                "Project Coordination"
              ],
              "soft_skills": [
                "Kepemimpinan Tim",
                "Komunikasi",
                "Delegasi",
                "Problem Solving",
                "Manajemen Waktu",
                "Pengambilan Keputusan"
              ],
              "employment_type": "Full-time",
              "experience_level": "Minimal 7 tahun pengalaman, termasuk 2 tahun di posisi supervisory",
              "salary_estimate": {
                "minimum": 20000000,
